#include <windows.h>
101 ICON "rm64.ico"
// Car brand logos, made by generate-brand-logos.ps1; src/BrandLogos.inc lists the cells.
102 RCDATA "brand-logos.png"
1 RT_MANIFEST "app.manifest"
// The version comes from project() in CMakeLists.txt.
1 VERSIONINFO
 FILEVERSION RACEMATE_VERSION_MAJOR,RACEMATE_VERSION_MINOR,RACEMATE_VERSION_PATCH,0
 PRODUCTVERSION RACEMATE_VERSION_MAJOR,RACEMATE_VERSION_MINOR,RACEMATE_VERSION_PATCH,0
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "RaceMate\0"
   VALUE "ProductName", "RaceMate\0"
   VALUE "FileVersion", RACEMATE_VERSION
   VALUE "ProductVersion", RACEMATE_VERSION
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
